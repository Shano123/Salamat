DATABASE_URL="postgresql://salamat:salamat@localhost:5432/salamat"
# Direct connection for migrations; keep it equal to DATABASE_URL unless you use a pooler (e.g. Supabase)
DIRECT_URL="postgresql://salamat:salamat@localhost:5432/salamat"
# Long random string used to sign session cookies
AUTH_SECRET="change-me-to-a-long-random-string"
# Shared secret for the scheduled alerts endpoint (/api/cron/alerts)
CRON_SECRET="change-me"
# Where selfies and uploaded files are stored
STORAGE_DIR="./storage"
